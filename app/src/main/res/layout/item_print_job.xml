<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="2dp"
    android:layout_marginVertical="6dp"
    android:clickable="false"
    android:focusable="false"
    app:cardBackgroundColor="@color/list_surface"
    app:cardCornerRadius="20dp"
    app:cardElevation="1dp"
    app:strokeColor="@color/list_border"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="17dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <FrameLayout
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/list_icon_container">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_gravity="center"
                    android:contentDescription="@string/printer_title"
                    android:src="@drawable/ic_printer"
                    app:tint="@color/list_accent" />

            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="13dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tv_job_nama"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:fontFamily="sans-serif-medium"
                    android:maxLines="1"
        android:text="Nama Barang"
                    android:textColor="@color/list_text_primary"
                    android:textSize="16sp" />

                <TextView
                    android:id="@+id/tv_job_sku"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:ellipsize="end"
                    android:fontFamily="monospace"
                    android:maxLines="1"
                    android:text="SKU: ABC123"
                    android:textColor="@color/list_text_muted"
                    android:textSize="12sp" />

            </LinearLayout>

            <TextView
                android:id="@+id/tv_job_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:background="@drawable/list_status_chip"
                android:fontFamily="sans-serif-medium"
                android:paddingHorizontal="11dp"
                android:paddingVertical="6dp"
        android:text="Menunggu"
                android:textColor="@color/list_accent"
                android:textSize="11sp" />

        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="15dp"
            android:background="@color/list_divider" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="13dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tv_job_harga"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="sans-serif-medium"
                android:text="Rp 25.000"
                android:textColor="@color/list_text_primary"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/tv_job_qty"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/list_metadata_chip"
                android:fontFamily="sans-serif-medium"
                android:paddingHorizontal="9dp"
                android:paddingVertical="4dp"
        android:text="Jumlah: 1"
                android:textColor="@color/list_accent_dark"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/tv_job_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="11dp"
                android:text="14:30 25/12"
                android:textColor="@color/list_text_muted"
                android:textSize="11sp" />

        </LinearLayout>

        <TextView
            android:id="@+id/tv_job_retry"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/list_retry_panel"
            android:fontFamily="sans-serif-medium"
            android:padding="10dp"
        android:text="Percobaan ulang: 1/3 - Printer tidak terhubung"
            android:textColor="@color/list_error"
            android:textSize="12sp"
            android:visibility="gone" />

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
