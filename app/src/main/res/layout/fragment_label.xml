<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:clipToPadding="false"
    android:fillViewport="true"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="88dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:text="@string/create_label_title"
            android:textColor="@color/text_primary"
            android:textSize="24sp"
            android:textStyle="bold" />

        <LinearLayout
            android:id="@+id/label_content_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_label_form"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardBackgroundColor="@color/surface"
            app:cardCornerRadius="24dp"
            app:cardElevation="0dp"
            app:strokeColor="@color/divider"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/Widget.NiimbotPrintAgent.TextInput"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="6dp"
                        android:layout_weight="1"
                        android:hint="@string/label_size"
                        app:endIconMode="dropdown_menu">

                        <AutoCompleteTextView
                            android:id="@+id/dropdown_label_size"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:contentDescription="@string/label_size_description"
                            android:inputType="none"
                            android:minHeight="56dp"
                            android:paddingStart="16dp"
                            android:paddingEnd="8dp"
                            android:popupBackground="@color/surface"
                            android:textColor="@color/text_primary"
                            android:textSize="16sp" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/Widget.NiimbotPrintAgent.TextInput"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:layout_weight="1"
                        android:hint="@string/label_layout"
                        app:endIconMode="dropdown_menu">

                        <AutoCompleteTextView
                            android:id="@+id/dropdown_label_layout"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:contentDescription="@string/label_layout_description"
                            android:inputType="none"
                            android:minHeight="56dp"
                            android:paddingStart="16dp"
                            android:paddingEnd="8dp"
                            android:popupBackground="@color/surface"
                            android:textColor="@color/text_primary"
                            android:textSize="16sp" />
                    </com.google.android.material.textfield.TextInputLayout>
                </LinearLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/til_label_sku"
                    style="@style/Widget.NiimbotPrintAgent.TextInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:hint="@string/label_sku"
                    app:helperText="@string/label_sku_auto_help">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/et_label_sku"
                        style="@style/Widget.NiimbotPrintAgent.FormEditText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:contentDescription="@string/label_sku_description"
                        android:imeOptions="actionNext"
                        android:inputType="textCapCharacters"
                        android:minHeight="48dp"
                        android:maxLines="1" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_scan_label_sku"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:minHeight="48dp"
                    android:text="@string/label_scan_sku" />

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/til_label_nama"
                    style="@style/Widget.NiimbotPrintAgent.TextInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:hint="@string/label_nama">

                    <AutoCompleteTextView
                        android:id="@+id/et_label_nama"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:contentDescription="@string/label_nama_description"
                        android:imeOptions="actionNext"
                        android:inputType="textCapSentences"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"
                        android:popupBackground="@color/surface"
                        android:textColor="@color/text_primary"
                        android:textSize="16sp"
                        android:minHeight="48dp"
                        android:maxLines="1" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/til_label_kode_harga_beli"
                    style="@style/Widget.NiimbotPrintAgent.TextInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:hint="@string/label_kode_harga_beli"
                    app:helperText="@string/label_kode_harga_beli_help">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/et_label_kode_harga_beli"
                        style="@style/Widget.NiimbotPrintAgent.FormEditText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:contentDescription="@string/label_kode_harga_beli_description"
                        android:imeOptions="actionNext"
                        android:inputType="textCapCharacters"
                        android:maxLines="1"
                        android:minHeight="48dp" />
                </com.google.android.material.textfield.TextInputLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="vertical">

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/til_label_harga_beli"
                        style="@style/Widget.NiimbotPrintAgent.TextInput"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="@string/label_harga_beli"
                        app:prefixText="Rp ">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/et_label_harga_beli"
                            style="@style/Widget.NiimbotPrintAgent.FormEditText"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:contentDescription="@string/label_harga_beli_description"
                            android:imeOptions="actionNext"
                            android:inputType="number"
                            android:minHeight="48dp"
                            android:maxLines="1" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/til_label_harga_jual"
                        style="@style/Widget.NiimbotPrintAgent.TextInput"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:hint="@string/label_harga_jual"
                        app:prefixText="Rp ">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/et_label_harga_jual"
                            style="@style/Widget.NiimbotPrintAgent.FormEditText"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:contentDescription="@string/label_harga_jual_description"
                            android:imeOptions="actionNext"
                            android:inputType="number"
                            android:minHeight="48dp"
                            android:maxLines="1" />
                    </com.google.android.material.textfield.TextInputLayout>
                </LinearLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/til_label_qty"
                    style="@style/Widget.NiimbotPrintAgent.TextInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:hint="@string/label_qty"
                    app:helperText="@string/label_qty_help">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/et_label_qty"
                        style="@style/Widget.NiimbotPrintAgent.FormEditText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:contentDescription="@string/label_qty_description"
                        android:imeOptions="actionDone"
                        android:inputType="number"
                        android:minHeight="48dp"
                        android:maxLines="1" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/switch_add_to_pos"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:contentDescription="@string/add_to_pos_description"
                    android:minHeight="48dp"
                    android:text="@string/add_to_pos"
                    android:textColor="@color/text_primary"
                    android:textSize="16sp" />

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/til_jumlah_barang_masuk"
                    style="@style/Widget.NiimbotPrintAgent.TextInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:enabled="false"
                    android:hint="@string/incoming_stock_qty"
                    app:helperText="@string/incoming_stock_qty_help">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/et_jumlah_barang_masuk"
                        style="@style/Widget.NiimbotPrintAgent.FormEditText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:contentDescription="@string/incoming_stock_qty_description"
                        android:imeOptions="actionDone"
                        android:inputType="number"
                        android:minHeight="48dp"
                        android:maxLines="1" />
                </com.google.android.material.textfield.TextInputLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_label_preview"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardBackgroundColor="@color/surface"
            app:cardCornerRadius="24dp"
            app:cardElevation="0dp"
            app:strokeColor="@color/divider"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/label_preview_live"
                    android:textColor="@color/text_primary"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <FrameLayout
                    android:id="@+id/preview_label_container"
                    android:layout_width="match_parent"
                    android:layout_height="280dp"
                    android:layout_marginTop="12dp"
                    android:background="@color/surface_variant"
                    android:padding="16dp">

                    <ImageView
                        android:id="@+id/iv_create_label_preview"
                        android:layout_width="300dp"
                        android:layout_height="180dp"
                        android:layout_gravity="center"
                        android:background="@color/white"
                        android:contentDescription="@string/label_preview_description"
                        android:elevation="4dp"
                        android:scaleType="fitCenter" />
                </FrameLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_update_label_preview"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="end"
                    android:layout_marginTop="12dp"
                    android:contentDescription="@string/update_preview_description"
                    android:minHeight="48dp"
                    android:text="@string/update_preview" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tv_label_remaining"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/label_remaining_unknown"
                android:textColor="@color/text_primary"
                android:textSize="15sp"
                android:textStyle="bold" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_refresh_label_remaining"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:contentDescription="@string/refresh_label_remaining_description"
                android:minHeight="48dp"
                android:text="@string/refresh" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_reset_label_form"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:contentDescription="@string/reset_label_form_description"
            android:minHeight="48dp"
            android:text="@string/reset_label_form" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_create_and_print"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:contentDescription="@string/create_and_print_description"
            android:minHeight="52dp"
            android:text="@string/create_and_print" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
