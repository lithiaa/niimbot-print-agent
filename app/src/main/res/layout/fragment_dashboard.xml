<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/dash_screen_bg"
    android:clipToPadding="false"
    android:fillViewport="true"
    android:overScrollMode="never">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="28dp">

        <!-- Indigo hero with a floating printer-status card. -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="292dp">

            <View
                android:layout_width="match_parent"
                android:layout_height="236dp"
                android:background="@drawable/dash_hero_gradient" />

            <View
                android:layout_width="144dp"
                android:layout_height="144dp"
                android:layout_gravity="top|end"
                android:layout_marginTop="8dp"
                android:layout_marginEnd="18dp"
                android:alpha="0.42"
                android:background="@drawable/dash_orb" />

            <View
                android:layout_width="76dp"
                android:layout_height="76dp"
                android:layout_gravity="top|end"
                android:layout_marginTop="82dp"
                android:layout_marginEnd="116dp"
                android:alpha="0.35"
                android:background="@drawable/dash_orb" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="top"
                android:orientation="vertical"
                android:paddingStart="20dp"
                android:paddingTop="22dp"
                android:paddingEnd="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="28dp"
                    android:background="@drawable/dash_pill_glass"
                    android:fontFamily="sans-serif-medium"
                    android:gravity="center"
                    android:letterSpacing="0.08"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:text="PRINT WORKSPACE"
                    android:textColor="#FFFFFFFF"
                    android:textSize="10sp" />

                <TextView
                    android:layout_width="260dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="13dp"
                    android:fontFamily="sans-serif"
                    android:lineSpacingExtra="1dp"
                    android:text="Ready when your labels are."
                    android:textColor="#FFFFFFFF"
                    android:textSize="27sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="250dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:text="Monitor your printer and every job from one place."
                    android:textColor="#D9FFFFFF"
                    android:textSize="12sp" />
            </LinearLayout>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="112dp"
                android:layout_gravity="bottom"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                android:layout_marginBottom="2dp"
                app:cardBackgroundColor="#FFFFFFFF"
                app:cardCornerRadius="24dp"
                app:cardElevation="9dp"
                app:strokeColor="#10000000"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp">

                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="54dp"
                        android:layout_height="54dp"
                        android:layout_marginEnd="14dp"
                        app:cardBackgroundColor="#EEEAFE"
                        app:cardCornerRadius="18dp"
                        app:cardElevation="0dp"
                        app:strokeWidth="0dp">

                        <ImageView
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:contentDescription="Printer"
                            android:padding="14dp"
                            android:src="@drawable/ic_printer"
                            app:tint="#5547E8" />
                    </com.google.android.material.card.MaterialCardView>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif-medium"
                            android:letterSpacing="0.06"
                            android:text="PRINTER STATUS"
                            android:textColor="#8C88A0"
                            android:textSize="10sp" />

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="3dp"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                android:id="@+id/tv_status_dot"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginEnd="7dp"
                                android:text="●"
                                android:textColor="@color/error"
                                android:textSize="13sp" />

                            <TextView
                                android:id="@+id/tv_printer_status"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="sans-serif"
                                android:text="Disconnected"
                                android:textColor="#211F2E"
                                android:textSize="19sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/tv_mac"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="3dp"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:text="No printer paired"
                            android:textColor="#8C88A0"
                            android:textSize="11sp" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="30dp"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/dash_pill_purple"
                        android:fontFamily="sans-serif-medium"
                        android:gravity="center"
                        android:paddingStart="11dp"
                        android:paddingEnd="11dp"
                        android:text="DEVICE"
                        android:textColor="#5547E8"
                        android:textSize="9sp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </FrameLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif"
                android:text="Quick actions"
                android:textColor="#211F2E"
                android:textSize="18sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_quick_test_print"
                    android:layout_width="0dp"
                    android:layout_height="52dp"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:backgroundTint="#5547E8"
                    android:fontFamily="sans-serif-medium"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:text="Test Print"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFFFF"
                    android:textSize="13sp"
                    app:cornerRadius="26dp"
                    app:icon="@drawable/ic_printer"
                    app:iconGravity="textStart"
                    app:iconPadding="7dp"
                    app:iconSize="18dp"
                    app:iconTint="#FFFFFFFF" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_open_queue"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="52dp"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:fontFamily="sans-serif-medium"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:text="Printer &amp; Queue"
                    android:textAllCaps="false"
                    android:textColor="#5547E8"
                    android:textSize="13sp"
                    app:cornerRadius="26dp"
                    app:icon="@drawable/ic_queue"
                    app:iconGravity="textStart"
                    app:iconPadding="7dp"
                    app:iconSize="18dp"
                    app:iconTint="#5547E8"
                    app:strokeColor="#D8D3FC"
                    app:strokeWidth="1dp" />
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_dashboard_create_label"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="12dp"
                android:backgroundTint="#EEEAFE"
                android:contentDescription="@string/dashboard_create_label_description"
                android:fontFamily="sans-serif-medium"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:text="@string/create_label_title"
                android:textAllCaps="false"
                android:textColor="#5547E8"
                android:textSize="13sp"
                app:cornerRadius="26dp"
                app:icon="@drawable/ic_preview"
                app:iconGravity="textStart"
                app:iconPadding="7dp"
                app:iconSize="18dp"
                app:iconTint="#5547E8" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:layout_marginBottom="11dp"
                android:gravity="bottom"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif"
                        android:text="Workspace overview"
                        android:textColor="#211F2E"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="Your latest print activity"
                        android:textColor="#8C88A0"
                        android:textSize="11sp" />
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="26dp"
                    android:background="@drawable/dash_pill_purple"
                    android:fontFamily="sans-serif-medium"
                    android:gravity="center"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:text="LIVE"
                    android:textColor="#5547E8"
                    android:textSize="9sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="0dp"
                    android:layout_height="142dp"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    app:cardBackgroundColor="#FFFFFFFF"
                    app:cardCornerRadius="20dp"
                    app:cardElevation="1dp"
                    app:strokeColor="#ECEAF5"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="vertical"
                        android:padding="14dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="36dp"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <com.google.android.material.card.MaterialCardView
                                android:layout_width="36dp"
                                android:layout_height="36dp"
                                app:cardBackgroundColor="#EEEAFE"
                                app:cardCornerRadius="12dp"
                                app:cardElevation="0dp"
                                app:strokeWidth="0dp">

                                <ImageView
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:contentDescription="Total jobs"
                                    android:padding="9dp"
                                    android:src="@drawable/ic_dashboard"
                                    app:tint="#5547E8" />
                            </com.google.android.material.card.MaterialCardView>

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="9dp"
                                android:layout_weight="1"
                                android:text="Total jobs"
                                android:textColor="#696579"
                                android:textSize="12sp" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/tv_total_count"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:fontFamily="sans-serif"
                            android:text="0"
                            android:textColor="#211F2E"
                            android:textSize="27sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tv_total_meta"
                            android:layout_width="wrap_content"
                            android:layout_height="24dp"
                            android:layout_marginTop="3dp"
                            android:background="@drawable/dash_pill_purple"
                            android:ellipsize="end"
                            android:gravity="center"
                            android:maxLines="1"
                            android:paddingStart="9dp"
                            android:paddingEnd="9dp"
                            android:text="No jobs yet"
                            android:textColor="#5547E8"
                            android:textSize="9sp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="0dp"
                    android:layout_height="142dp"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    app:cardBackgroundColor="#FFFFFFFF"
                    app:cardCornerRadius="20dp"
                    app:cardElevation="1dp"
                    app:strokeColor="#ECEAF5"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="vertical"
                        android:padding="14dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="36dp"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <com.google.android.material.card.MaterialCardView
                                android:layout_width="36dp"
                                android:layout_height="36dp"
                                app:cardBackgroundColor="#EAF6FF"
                                app:cardCornerRadius="12dp"
                                app:cardElevation="0dp"
                                app:strokeWidth="0dp">

                                <ImageView
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:contentDescription="Pending jobs"
                                    android:padding="9dp"
                                    android:src="@drawable/ic_queue"
                                    app:tint="#2586D9" />
                            </com.google.android.material.card.MaterialCardView>

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="9dp"
                                android:layout_weight="1"
                                android:text="Pending"
                                android:textColor="#696579"
                                android:textSize="12sp" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/tv_pending_count"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:fontFamily="sans-serif"
                            android:text="0"
                            android:textColor="#211F2E"
                            android:textSize="27sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tv_pending_meta"
                            android:layout_width="wrap_content"
                            android:layout_height="24dp"
                            android:layout_marginTop="3dp"
                            android:background="@drawable/dash_pill_blue"
                            android:ellipsize="end"
                            android:gravity="center"
                            android:maxLines="1"
                            android:paddingStart="9dp"
                            android:paddingEnd="9dp"
                            android:text="0 printing"
                            android:textColor="#2586D9"
                            android:textSize="9sp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal">

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="0dp"
                    android:layout_height="142dp"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    app:cardBackgroundColor="#FFFFFFFF"
                    app:cardCornerRadius="20dp"
                    app:cardElevation="1dp"
                    app:strokeColor="#ECEAF5"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="vertical"
                        android:padding="14dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="36dp"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <com.google.android.material.card.MaterialCardView
                                android:layout_width="36dp"
                                android:layout_height="36dp"
                                app:cardBackgroundColor="#EAFBF2"
                                app:cardCornerRadius="12dp"
                                app:cardElevation="0dp"
                                app:strokeWidth="0dp">

                                <ImageView
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:contentDescription="Done jobs"
                                    android:padding="9dp"
                                    android:src="@drawable/ic_printer"
                                    app:tint="#21A66C" />
                            </com.google.android.material.card.MaterialCardView>

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="9dp"
                                android:layout_weight="1"
                                android:text="Done"
                                android:textColor="#696579"
                                android:textSize="12sp" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/tv_done_count"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:fontFamily="sans-serif"
                            android:text="0"
                            android:textColor="#211F2E"
                            android:textSize="27sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tv_done_meta"
                            android:layout_width="wrap_content"
                            android:layout_height="24dp"
                            android:layout_marginTop="3dp"
                            android:background="@drawable/dash_pill_green"
                            android:ellipsize="end"
                            android:gravity="center"
                            android:maxLines="1"
                            android:paddingStart="9dp"
                            android:paddingEnd="9dp"
                            android:text="0% of total"
                            android:textColor="#178A58"
                            android:textSize="9sp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="0dp"
                    android:layout_height="142dp"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    app:cardBackgroundColor="#FFFFFFFF"
                    app:cardCornerRadius="20dp"
                    app:cardElevation="1dp"
                    app:strokeColor="#ECEAF5"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="vertical"
                        android:padding="14dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="36dp"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <com.google.android.material.card.MaterialCardView
                                android:layout_width="36dp"
                                android:layout_height="36dp"
                                app:cardBackgroundColor="#FFF0F2"
                                app:cardCornerRadius="12dp"
                                app:cardElevation="0dp"
                                app:strokeWidth="0dp">

                                <ImageView
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:contentDescription="Failed jobs"
                                    android:padding="9dp"
                                    android:src="@drawable/ic_logs"
                                    app:tint="#DF5670" />
                            </com.google.android.material.card.MaterialCardView>

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="9dp"
                                android:layout_weight="1"
                                android:text="Failed"
                                android:textColor="#696579"
                                android:textSize="12sp" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/tv_failed_count"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:fontFamily="sans-serif"
                            android:text="0"
                            android:textColor="#211F2E"
                            android:textSize="27sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tv_failed_meta"
                            android:layout_width="wrap_content"
                            android:layout_height="24dp"
                            android:layout_marginTop="3dp"
                            android:background="@drawable/dash_pill_red"
                            android:ellipsize="end"
                            android:gravity="center"
                            android:maxLines="1"
                            android:paddingStart="9dp"
                            android:paddingEnd="9dp"
                            android:text="No failures"
                            android:textColor="#CB405B"
                            android:textSize="9sp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="78dp"
                android:layout_marginTop="12dp"
                app:cardBackgroundColor="#FFFFFFFF"
                app:cardCornerRadius="20dp"
                app:cardElevation="1dp"
                app:strokeColor="#ECEAF5"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="28dp"
                        android:background="@drawable/dash_pill_purple"
                        android:fontFamily="sans-serif-medium"
                        android:gravity="center"
                        android:letterSpacing="0.05"
                        android:paddingStart="10dp"
                        android:paddingEnd="10dp"
                        android:text="UPTIME"
                        android:textColor="#5547E8"
                        android:textSize="9sp" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="13dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tv_uptime"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif"
                            android:text="0m"
                            android:textColor="#211F2E"
                            android:textSize="21sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Print agent runtime"
                            android:textColor="#8C88A0"
                            android:textSize="10sp" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Active now"
                        android:textColor="#21A66C"
                        android:textSize="11sp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="25dp"
                android:layout_marginBottom="11dp"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif"
                    android:text="Print insights"
                    android:textColor="#211F2E"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Performance at a glance"
                    android:textColor="#8C88A0"
                    android:textSize="11sp" />
            </LinearLayout>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="#FFFFFFFF"
                app:cardCornerRadius="22dp"
                app:cardElevation="1dp"
                app:strokeColor="#ECEAF5"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="17dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="0dp"
