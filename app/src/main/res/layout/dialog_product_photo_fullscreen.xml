<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F0000000"
    android:fitsSystemWindows="true">

    <ImageView
        android:id="@+id/iv_product_photo_fullscreen"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_margin="24dp"
        android:adjustViewBounds="true"
        android:contentDescription="@string/product_photo_description"
        android:scaleType="fitCenter"
        android:visibility="invisible" />

    <ProgressBar
        android:id="@+id/progress_product_photo_fullscreen"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_gravity="center"
        android:indeterminateTint="@color/white" />

    <TextView
        android:id="@+id/tv_product_photo_fullscreen_error"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center"
        android:padding="24dp"
        android:text="@string/product_photo_load_failed"
        android:textColor="@color/white"
        android:textSize="15sp"
        android:visibility="gone" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_product_photo_fullscreen_close"
        style="@style/Widget.MaterialComponents.Button.TextButton"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_gravity="top|end"
        android:layout_margin="16dp"
        android:contentDescription="@string/product_photo_fullscreen_close"
        android:insetLeft="0dp"
        android:insetTop="0dp"
        android:insetRight="0dp"
        android:insetBottom="0dp"
        android:minWidth="48dp"
        android:padding="12dp"
        android:text=""
        app:backgroundTint="#66000000"
        app:cornerRadius="24dp"
        app:icon="@drawable/ic_close"
        app:iconGravity="textStart"
        app:iconPadding="0dp"
        app:iconTint="@color/white" />
</FrameLayout>
