<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="8dp"
    app:cardElevation="1dp"
    app:cardCornerRadius="8dp"
    app:strokeColor="@color/divider"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="16dp"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/tv_log_action"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🖨 PRINTING_STARTED"
            android:textSize="13sp"
            android:textColor="@color/text_primary"
            android:fontFamily="sans-serif-medium"
            android:layout_marginEnd="16dp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

                <TextView
                    android:id="@+id/tv_log_job_id"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Job #123"
                    android:textSize="12sp"
                    android:textColor="@color/text_muted"
                    android:fontFamily="monospace" />

                <TextView
                    android:id="@+id/tv_log_message"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Printing label for Product A"
                    android:textSize= "13sp"
                    android:textColor="@color/text_secondary" />

        </LinearLayout>

        <TextView
            android:id="@+id/tv_log_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="14:30:25 25/12"
            android:textSize="11sp"
            android:textColor="@color/text_muted"
            android:fontFamily="monospace"
            android:layout_marginStart="16dp" />

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>