<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="8dp"
    android:paddingTop="8dp"
    android:paddingEnd="8dp">

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/layout_supplier_order_name"
        style="@style/Widget.LithiaLabelPrinter.TextInput"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/supplier_order_name">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/et_supplier_order_name"
            style="@style/Widget.LithiaLabelPrinter.FormEditText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="textCapSentences"
            android:maxLength="200"
            android:maxLines="2" />
    </com.google.android.material.textfield.TextInputLayout>

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/layout_supplier_order_quantity"
        style="@style/Widget.LithiaLabelPrinter.TextInput"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:hint="@string/supplier_order_quantity">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/et_supplier_order_quantity"
            style="@style/Widget.LithiaLabelPrinter.FormEditText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:imeOptions="actionNext"
            android:inputType="number"
            android:maxLines="1" />
    </com.google.android.material.textfield.TextInputLayout>

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/layout_supplier_order_status"
        style="@style/Widget.LithiaLabelPrinter.TextInput"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:hint="@string/supplier_order_status"
        app:endIconMode="dropdown_menu">

        <AutoCompleteTextView
            android:id="@+id/act_supplier_order_status"
            style="@style/Widget.LithiaLabelPrinter.FormEditText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/supplier_order_status"
            android:inputType="none"
            android:maxLines="1" />
    </com.google.android.material.textfield.TextInputLayout>
</LinearLayout>
